# คัดลอกส่วนนี้ไปวางใน Streamlit Cloud > App > Settings > Secrets
# ห้าม commit secrets.toml จริงลง GitHub

[passwords]
INPUT = "replace-with-unique-strong-password"
REPORT = "replace-with-another-strong-password"
ADMIN = "replace-with-admin-strong-password"

[supabase]
url = "https://YOUR-PROJECT.supabase.co"
key = "YOUR_SUPABASE_SERVICE_ROLE_KEY"

LINE_CHANNEL_ACCESS_TOKEN = "YOUR_EXISTING_LINE_OA_CHANNEL_ACCESS_TOKEN"
APP_PUBLIC_URL = "https://YOUR-APP.streamlit.app"

GDRIVE_FOLDER_ID = "YOUR_GOOGLE_DRIVE_FOLDER_ID"

[gdrive]
type = "service_account"
project_id = "your-project-id"
private_key_id = "replace"
private_key = "-----BEGIN PRIVATE KEY-----\\nREPLACE\\n-----END PRIVATE KEY-----\\n"
client_email = "your-service-account@your-project.iam.gserviceaccount.com"
client_id = "replace"
token_uri = "https://oauth2.googleapis.com/token"
